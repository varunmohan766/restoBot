<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
    <Dialog title="Select Food">
        <Table id="nameTable" inset="false" items="{/stockList}">
            <columns>
                <Column>
                    <Text text="Food"/>
                </Column>
                <Column>
                    <Text text="Quantity"/>
                </Column>
                <Column>
                    <Text text="Status"/>
                </Column>
                <Column>
                    <Text text="Price"/>
                </Column>
            </columns>
            <items>
                <!-- Row click triggers onSelectName -->
                <ColumnListItem type="Active" press="onSelectFood">
                    <cells>
                        <Text text="{Name}"/>
                        <Text text="{Quantity}"/>
                        <Text text="{Status}"/>
                        <Text text="{Price}"/>
                    </cells>
                </ColumnListItem>
            </items>
        </Table>
        <endButton>
            <Button text="Close" press="onCloseValueHelp"/>
        </endButton>
    </Dialog>
</core:FragmentDefinition>
